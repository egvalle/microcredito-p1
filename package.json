{
  "name": "microcredito-p1",
  "version": "1.0.0",
  "description": "Sistema de Gestión de Microcrédito Crédito Vecino",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc && tsc --noEmit -p tsconfig.app.json && vite build",
    "demo": "npm run build && node dist/demo/calculos-demo.js",
    "db:load": "npm run build && node dist/persistencia/inicializar.js && node dist/persistencia/materializar-cuotas.js && node dist/persistencia/materializar-pagos.js",
    "db:materializar-cuotas": "npm run build && node dist/persistencia/materializar-cuotas.js",
    "db:materializar-pagos": "npm run build && node dist/persistencia/materializar-pagos.js",
    "db:rag": "npm run build && node dist/rag/ingestar.js",
    "mcp": "npm run build && node dist/mcp/server.js",
    "dev": "concurrently \"npm:dev:api\" \"vite --host 127.0.0.1\"",
    "dev:api": "tsx watch src/api/server.ts",
    "start": "node dist/api/server.js"
  },
  "dependencies": {
    "@langchain/core": "^1.3.4",
    "@langchain/ollama": "^1.3.0",
    "@langchain/textsplitters": "^1.0.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^7.3.7",
    "vitest": "^3.2.0"
  }
}
